{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker.ImportScripts"],
    "types": ["vite/client"]
  },
  "include": ["src/utils/**/*.js", "src/services/**/*.js", "src/router.js", "worker/**/*.js", "scripts/**/*.mjs", "src/types/*.d.ts"],
  "exclude": ["**/*.test.js", "**/*.test.mjs", "dist"]
}
