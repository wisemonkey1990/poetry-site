{
  "name": "poetry",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-19",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  // 跨实例的限流计数（Workers Rate Limiting）：纠错/提意见每 IP 每分钟 3 次，错误上报每分钟 30 次
  "ratelimits": [
    { "name": "SUBMIT_LIMITER", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } },
    { "name": "ERROR_LIMITER", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }
  ],
  "vars": { "GITHUB_REPO": "wisemonkey1990/poetry-site" },
  "routes": [{ "pattern": "poetry.lightos.wiki", "custom_domain": true }]
}
