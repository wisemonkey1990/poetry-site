{
  "name": "poetry",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-19",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": { "GITHUB_REPO": "wisemonkey1990/poetry-site" },
  "routes": [{ "pattern": "poetry.lightos.wiki", "custom_domain": true }]
}
